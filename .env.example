# Copy to .env and fill in values before starting
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root
MW_SECRET_KEY=generate_with__openssl_rand_hex_32
ALTCHA_HMAC_KEY=generate_with__openssl_rand_hex_32
MW_ADMIN_PASSWORD=changeme_admin
MW_PORT=3000
MW_EMAIL_CONFIRM_TO_EDIT=true
MW_DEBUG=false
MW_SERVER=https://your.domain.here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=wiki@altered.wiki
SMTP_PASSWORD=changeme
SMTP_FROM=wiki@altered.wiki
# Deploy webhook
WIKI_USERNAME=User@BotName
WIKI_PASSWORD=the-generated-bot-password
WEBHOOK_SECRET=a-random-secret-you-choose
DEPLOY_REPO_URL=https://github.com/your-org/altered-wiki-src
WEBHOOK_PORT=9000
